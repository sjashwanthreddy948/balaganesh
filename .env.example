# ===================================================
# Bala Ganesh Association - Environment Configuration
# Copy this file to .env and configure your values.
# ===================================================

# Database Connection (SQLite locally, or PostgreSQL for cloud deployment)
DATABASE_URL="file:./dev.db"

# Authentication Secret (Generate a strong random secret in production)
JWT_SECRET="your-jwt-secret-key-at-least-32-characters"

# Default Admin Credentials for initial setup
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASSWORD="your-strong-admin-password"

# Association Branding & Information
NEXT_PUBLIC_ASSOCIATION_NAME="BALA GANESH ASSOCIATION"
NEXT_PUBLIC_FESTIVAL_YEAR="2026"
NEXT_PUBLIC_RECEIPT_PREFIX="BG2026"
NEXT_PUBLIC_ASSOCIATION_ADDRESS="Main Road, Ganesh Pandal, Hyderabad, Telangana"

# Payment Details (UPI)
NEXT_PUBLIC_UPI_ID="balaganesh@upi"
NEXT_PUBLIC_UPI_PAYEE_NAME="BALA GANESH ASSOCIATION"
