# ===================================================
# Bala Ganesh Association - Environment Configuration
# Copy this file to .env and configure your values.
# ===================================================

# Database Connection (Supabase PostgreSQL in Mumbai, India ap-south-1)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Authentication Secret (Generate a strong random secret in production)
JWT_SECRET="your-jwt-secret-key-at-least-32-characters"

# Default Admin Credentials for initial setup
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASSWORD="your-strong-admin-password"

# Association Branding & Information
NEXT_PUBLIC_ASSOCIATION_NAME="BALA GANESH ASSOCIATION"
NEXT_PUBLIC_FESTIVAL_YEAR="2026"
NEXT_PUBLIC_RECEIPT_PREFIX="BG2026"
NEXT_PUBLIC_ASSOCIATION_ADDRESS="Bhavani Nagar, Shankarpally, Telangana"

# Payment Details (UPI)
NEXT_PUBLIC_UPI_ID="rajashekarchilumula1656@okaxis"
NEXT_PUBLIC_UPI_PAYEE_NAME="BALA GANESH ASSOCIATION"

# WhatsApp Community & Group
