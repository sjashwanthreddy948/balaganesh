generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  password       String         // Hashed password
  name           String
  role           String         @default("VOLUNTEER") // ADMIN or VOLUNTEER
  mobile         String?
  isActive       Boolean        @default(true)
  canAddExpenses Boolean        @default(false)       // Permission to add expenses
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdContributions  Contribution[]  @relation("CreatedBy")
  verifiedContributions Contribution[]  @relation("VerifiedBy")
  createdExpenses       Expense[]       @relation("ExpenseCreatedBy")
  createdLadduBalances  LadduBalance[]  @relation("LadduBalanceCreatedBy")
  createdLadduPayments  LadduPayment[]  @relation("LadduPaymentCreatedBy")

  @@index([username])
}

model Contributor {
  id            String         @id @default(cuid())
  fullName      String
  mobileNumber  String         @unique
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  contributions Contribution[]
  ladduBalances LadduBalance[]

  @@index([mobileNumber])
  @@index([fullName])
}

model Contribution {
  id                String   @id @default(cuid())
  certificateNumber String   @unique // e.g. BG2026-000001
  fullName          String
  mobileNumber      String?
  address           String?
  amount            Int      // Amount in whole rupees
  paymentMethod     String   // CASH or ONLINE
  paymentStatus     String   // CASH_RECEIVED, PENDING, VERIFIED, REJECTED
  utr               String?  // Optional UTR for online payments
  paymentScreenshot String?  // Optional uploaded payment screenshot
  notes             String?
  year              Int      @default(2026)

  contributorId     String?
  contributor       Contributor? @relation(fields: [contributorId], references: [id])

  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])

  verifiedById      String?
  verifiedBy        User?    @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([mobileNumber])
  @@index([certificateNumber])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([createdAt])
  @@index([fullName])
  @@index([contributorId])
}

model LadduBalance {
  id               String         @id @default(cuid())
  personName       String
  mobileNumber     String?
  address          String?
  ladduYear        Int            @default(2025)
  totalDue         Int            // Total amount due for Laddu
  totalPaid        Int            @default(0)   // Total accumulated payments
  remainingBalance Int            // totalDue - totalPaid
  status           String         @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  notes            String?

  contributorId    String?
  contributor      Contributor?   @relation(fields: [contributorId], references: [id])

  createdById      String
  createdBy        User           @relation("LadduBalanceCreatedBy", fields: [createdById], references: [id])

  payments         LadduPayment[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([personName])
  @@index([mobileNumber])
  @@index([ladduYear])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([contributorId])
}

model LadduPayment {
  id                String        @id @default(cuid())
  receiptNumber     String        @unique // e.g. LDR2026-000001
  ladduBalanceId    String
  ladduBalance      LadduBalance  @relation(fields: [ladduBalanceId], references: [id], onDelete: Cascade)
  amount            Int           // Amount paid in this installment
  paymentMethod     String        // CASH, ONLINE
  utr               String?       // UTR for ONLINE payments
  paymentScreenshot String?       // Optional uploaded payment screenshot
  notes             String?

  createdById       String
  createdBy         User          @relation("LadduPaymentCreatedBy", fields: [createdById], references: [id])

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([receiptNumber])
  @@index([ladduBalanceId])
  @@index([paymentMethod])
  @@index([createdById])
  @@index([createdAt])
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String   @unique // e.g. EXP-2026-000001
  shopName      String
  category      String   // Decorations, Flowers, Ganesh Idol, Electrical, Sound System, Lighting, Pooja Materials, Food / Prasadam, Printing, Transport, Cleaning, Miscellaneous
  description   String?
  amount        Int      // Amount in whole rupees
  paymentMethod String   // CASH, ONLINE
  date          DateTime // Date of the expense
  notes         String?
  billImage     String?  // URL of optional receipt / bill image
  enteredBy     String   @default("Admin") // Name of the person who entered this expense

  // Advance Payment Tracking
  isAdvance         Boolean  @default(false)
  totalCost         Int?     // Total agreed contract / bill amount
  advanceAmount     Int?     // Advance paid (equals amount)
  pendingBalance    Int?     // Remaining balance due to vendor (totalCost - amount)

  createdById   String
  createdBy     User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([paymentMethod])
  @@index([date])
  @@index([createdById])
  @@index([expenseNumber])
  @@index([enteredBy])
  @@index([isAdvance])
}
