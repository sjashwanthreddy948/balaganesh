generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  password       String         // Hashed password
  name           String
  role           String         @default("VOLUNTEER") // ADMIN or VOLUNTEER
  mobile         String?
  isActive       Boolean        @default(true)
  canAddExpenses Boolean        @default(false)       // Permission to add expenses
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdContributions Contribution[] @relation("CreatedBy")
  verifiedContributions Contribution[] @relation("VerifiedBy")
  createdExpenses      Expense[]      @relation("ExpenseCreatedBy")

  @@index([username])
}

model Contribution {
  id                String   @id @default(cuid())
  certificateNumber String   @unique // e.g. BG2026-000001
  fullName          String
  mobileNumber      String?
  address           String?
  amount            Int      // Amount in whole rupees
  paymentMethod     String   // CASH or ONLINE
  paymentStatus     String   // CASH_RECEIVED, PENDING, VERIFIED, REJECTED
  utr               String?  // Optional UTR for online payments
  paymentScreenshot String?  // Optional uploaded payment screenshot
  notes             String?

  createdById       String
  createdBy         User     @relation("CreatedBy", fields: [createdById], references: [id])

  verifiedById      String?
  verifiedBy        User?    @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([mobileNumber])
  @@index([certificateNumber])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([createdAt])
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String   @unique // e.g. EXP-2026-000001
  shopName      String
  category      String   // Decorations, Flowers, Ganesh Idol, Electrical, Sound System, Lighting, Pooja Materials, Food / Prasadam, Printing, Transport, Cleaning, Miscellaneous
  description   String?
  amount        Int      // Amount in whole rupees
  paymentMethod String   // CASH, ONLINE
  date          DateTime // Date of the expense
  notes         String?
  billImage     String?  // URL of optional receipt / bill image
  enteredBy     String   @default("Admin") // Name of the person who entered this expense

  createdById   String
  createdBy     User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([paymentMethod])
  @@index([date])
  @@index([createdById])
  @@index([expenseNumber])
  @@index([enteredBy])
}
